---
import { cn } from "@lib/utils";

interface Props {
  class?: string;
  external?: boolean;
  href?: string;
  title?: string;
}

const { class: className, href, title, external } = Astro.props as Props;

const classes = cn(
  "cursor-pointer rounded-sm bg-accent px-6 py-2 text-center font-bold text-background text-sm shadow-md transition-colors hover:bg-accent/90 lg:px-8",
  className
);
---

{href ? (
    <a class={classes} href={href} rel={external ? "noopener noreferrer" : undefined} target={external ? "_blank" : undefined} title={title}>
      <slot />
    </a>
  ) : (
    <button class={classes} title={title} type="button">
      <slot />
    </button>
  )}
